# Rokid → Hermes Bridge 配置

# Hermes Gateway API 地址
HERMES_GATEWAY_URL=http://localhost:8642

# 使用的模型
HERMES_MODEL=mimo-v2.5

# 灵珠平台的鉴权密钥（在灵珠平台创建智能体后获取）
ROKID_AK=your-ak-here

# 桥接服务端口
BRIDGE_PORT=8900

# Hermes Gateway API Key（从 ~/.hermes/.env 的 API_SERVER_KEY 获取）
HERMES_API_KEY=your-gateway-api-key-here

# 启用记忆提取（可选，需要 Mnemosyne）
# ENABLE_MEMORY_EXTRACTOR=false

# 记忆后端（可选，默认 mnemosyne）
# MEMORY_BACKEND=mnemosyne
